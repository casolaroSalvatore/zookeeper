name: ZooKeeper CI 

on:
  push:
    branches: [ "testing" ]

jobs:
  build-and-test:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v3

    - name: Set up JDK 17
      uses: actions/setup-java@v3
      with:
        java-version: '17'
        distribution: 'temurin'
        cache: maven

    - name: Build and Test SUT Classes (JUnit & JaCoCo)

      run: mvn clean test jacoco:report -pl zookeeper-server -DskipTests=false -Dcheckstyle.skip=true -Dspotbugs.skip=true -Dmaven.javadoc.skip=true

    - name: Run Mutation Testing (PITest)
      run: mvn org.pitest:pitest-maven:mutationCoverage -pl zookeeper-server